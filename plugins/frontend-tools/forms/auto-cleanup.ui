   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>560</width>
    <height>380</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>录制后自动清理</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QLabel" name="recordingPathLabel">
     <property name="text">
      <string>录制路径：读取中...</string>
     </property>
     <property name="wordWrap">true</property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="shortClipGroup">
     <property name="title">
      <string>短视频误操作清理</string>
     </property>
     <layout class="QFormLayout" name="shortLayout">
      <item row="0" column="0" colspan="2">
       <widget class="QCheckBox" name="deleteShortClips">
        <property name="text">
         <string>录制时长小于阈值，则删除所有文件（原始 + 封装后）</string>
        </property>
        <property name="checked">true</property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="thresholdLabel">
        <property name="text">
         <string>阈值（秒）</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="shortClipThreshold">
        <property name="minimum">1</property>
        <property name="maximum">120</property>
        <property name="value">10</property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="remuxGroup">
     <property name="title">
      <string>自动封装后清理</string>
     </property>
     <layout class="QVBoxLayout" name="remuxLayout">
      <item>
       <widget class="QLabel" name="remuxInfo">
        <property name="text">
         <string>检测中...</string>
        </property>
        <property name="wordWrap">true</property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="deleteOriginAfterRemux">
        <property name="text">
         <string>录制完成后自动删除原始 MKV 文件（保留 MP4）</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>

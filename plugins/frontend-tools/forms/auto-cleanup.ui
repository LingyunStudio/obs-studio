<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AutoCleanupDialog</class>
 <widget class="QDialog" name="AutoCleanupDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>560</width>
    <height>400</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>560</width>
    <height>400</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>录制后自动清理</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QGroupBox" name="groupBox">
     <property name="title">
      <string>基本设置</string>
     </property>
     <layout class="QVBoxLayout" name="basicLayout">
      <item>
       <widget class="QCheckBox" name="enableAutoCleanup">
        <property name="text">
         <string>启用自动清理</string>
        </property>
        <property name="checked">true</property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="recordingFolder">
        <property name="text">
         <string>当前录制路径：自动读取OBS设置</string>
        </property>
        <property name="wordWrap">true</property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBoxShort">
     <property name="title">
      <string>短录制清理</string>
     </property>
     <layout class="QFormLayout" name="formLayoutShort">
      <item row="0" column="0" colspan="2">
       <widget class="QCheckBox" name="deleteShortClips">
        <property name="text">
         <string>短录制彻底删除所有文件（不保留任何格式）</string>
        </property>
        <property name="checked">true</property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="thresholdLabel">
        <property name="text">
         <string>短录制阈值（秒）：</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="shortClipThreshold">
        <property name="minimum">1</property>
        <property name="maximum">120</property>
        <property name="value">10</property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBoxRemux">
     <property name="title">
      <string>自动封装后清理</string>
     </property>
     <layout class="QVBoxLayout" name="remuxLayout">
      <item>
       <widget class="QCheckBox" name="deleteOriginAfterRemux">
        <property name="text">
         <string>检测中...</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBoxAllFormats">
     <property name="title">
      <string>通用清理（未开启自动封装时使用）</string>
     </property>
     <layout class="QVBoxLayout" name="allFormatsLayout">
      <item>
       <widget class="QCheckBox" name="applyToAllFormats">
        <property name="text">
         <string>录制完成后自动删除原始录制文件（适用于所有录制格式）</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons">
      <set>QDialogButtonBox::Close|QDialogButtonBox::Save</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>

<ui version="4.0">
 <class>AutoCleanupDialog</class>
 <widget class="QDialog" name="AutoCleanupDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>540</width>
    <height>320</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>540</width>
    <height>320</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>录制后自动清理</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QGroupBox" name="groupBox">
     <property name="title">
      <string>基本设置</string>
     </property>
     <layout class="QFormLayout" name="formLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="labelEnable">
        <property name="text">
         <string>启用：</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QCheckBox" name="enableAutoCleanup">
        <property name="checked">true</property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="labelFolder">
        <property name="text">
         <string>录制文件夹：</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="recordingFolder">
        <property name="placeholderText">
         <string>留空 = OBS默认录制路径</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBoxShort">
     <property name="title">
      <string>短录制清理</string>
     </property>
     <layout class="QFormLayout" name="formLayoutShort">
      <item row="0" column="0">
       <widget class="QLabel" name="labelDeleteShort">
        <property name="text">
         <string>同时删除MP4：</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QCheckBox" name="deleteShortClips">
        <property name="checked">true</property>
        <property name="text">
         <string>（勾选后短录制会彻底删除，不保留任何文件）</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="labelThreshold">
        <property name="text">
         <string>短录制阈值（秒）：</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="shortClipThreshold">
        <property name="toolTip">
         <string>小于此秒数的录制将被视为误操作</string>
        </property>
        <property name="minimum">1</property>
        <property name="maximum">120</property>
        <property name="value">10</property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons">
      <set>QDialogButtonBox::Close|QDialogButtonBox::Save</set>
     </property>
    </widget>
   </item>
  </layout>
